# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=todds_library
POSTGRES_USER=todds
POSTGRES_PASSWORD=todds_secret

# ── Redis ────────────────────────────────────────────────
# (no additional config needed)

# ── MeiliSearch ─────────────────────────────────────────
MEILI_MASTER_KEY=todds_meili_master_key
MEILI_ENV=development

# ── Authentik (OIDC) — optional ─────────────────────────
# Leave blank to use local username/password auth.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# ── Backend ─────────────────────────────────────────────
# JWT / encryption secret — generate with: openssl rand -hex 32
SECRET_KEY=change_me_in_production
UVICORN_WORKERS=4
BACKEND_PORT=8830
# Short-lived access token TTL in seconds (used by API/streaming auth).
# Keep it >= the expected duration of backgrounded playback sessions: media
# URLs are baked with this token at load time, and the frontend re-applies a
# fresh token to HLS requests while playing, but direct-track playback relies
# on the token staying valid for the whole file. Default 900s (15 min).
ACCESS_TOKEN_TTL=900
# Redis session token lifetime in days (sliding TTL, refreshed on use).
SESSION_TTL_DAYS=30

# ── rreading-glasses metadata mirror ───────────────────
# Defaults to the Goodreads-backed image.
# Only switch to the Hardcover tag if you also provide a valid bearer token.
RREADING_GLASSES_IMAGE=blampe/rreading-glasses:latest
RREADING_GLASSES_PORT=8788
RREADING_GLASSES_POSTGRES_DB=rreading-glasses
RREADING_GLASSES_POSTGRES_USER=rreading-glasses
RREADING_GLASSES_POSTGRES_PASSWORD=change-me
RREADING_GLASSES_HARDCOVER_AUTH=

# ── Frontend (Next.js) ─────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_in_production
# Dev/Docker host access: http://localhost:8830/api
NEXT_PUBLIC_API_URL=http://localhost:8830/api

# ── Castwright (host-mode, TTS for EPUBs) ─────────────────
# Host Castwright URL — default 9990 as required; backend runs in Docker and reaches host via host-gateway.
CASTWRIGHT_URL=http://host.docker.internal:9990
CASTWRIGHT_ENABLED=true
# Ollama URL for model listing (default localhost:11434)
OLLAMA_URL=http://host.docker.internal:11434
# Optional override for generated audio; empty => per-book folder "generated_audio" alongside EPUB (scanner-visible)
GENERATED_AUDIO_DIR=
CASTWRIGHT_TIMEOUT_S=300

# ── Books (volume mounts) ──────────────────────────────
# Set this to the local path where your ebooks/audiobooks are stored.
# Default: ./books (relative to docker-compose.yml)
# BOOKS_DIR=/mnt/media/books
