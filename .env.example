# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=todds_library
POSTGRES_USER=todds
POSTGRES_PASSWORD=todds_secret

# ── Redis ────────────────────────────────────────────────
# (no additional config needed)

# ── MeiliSearch ─────────────────────────────────────────
MEILI_MASTER_KEY=todds_meili_master_key
MEILI_ENV=development

# ── Authentik (OIDC) — optional ─────────────────────────
# Leave blank to use local username/password auth.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# ── Backend ─────────────────────────────────────────────
# JWT / encryption secret — generate with: openssl rand -hex 32
SECRET_KEY=change_me_in_production
UVICORN_WORKERS=4
BACKEND_PORT=8830

# ── rreading-glasses metadata mirror ───────────────────
# Defaults to the Goodreads-backed image.
# Only switch to the Hardcover tag if you also provide a valid bearer token.
RREADING_GLASSES_IMAGE=blampe/rreading-glasses:latest
RREADING_GLASSES_PORT=8788
RREADING_GLASSES_POSTGRES_DB=rreading-glasses
RREADING_GLASSES_POSTGRES_USER=rreading-glasses
RREADING_GLASSES_POSTGRES_PASSWORD=change-me
RREADING_GLASSES_HARDCOVER_AUTH=

# ── Frontend (Next.js) ─────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_in_production
# Dev/Docker host access: http://localhost:8830/api
NEXT_PUBLIC_API_URL=http://localhost:8830/api

# ── Books (volume mounts) ──────────────────────────────
# Set this to the local path where your ebooks/audiobooks are stored.
# Default: ./books (relative to docker-compose.yml)
# BOOKS_DIR=/mnt/media/books
